<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- SMALL SEGMENTED ARCH -->
  <ThingDef ParentName="BuildingBase">
    <defName>UEM_Arch_Segmented_One</defName>
    <label>Small Segmented Arch</label>
    <description>A decorative arch meant to be placed over doorways and between walls. This one is one tile wide.</description>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2041</uiOrder>
    <altitudeLayer>PawnUnused</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>10</Beauty>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <canOverlapZones>true</canOverlapZones>
    <fertility>0</fertility>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <paintable>true</paintable>
      <isEdifice>false</isEdifice>
      <isPlaceOverableWall>true</isPlaceOverableWall>
    </building>
    <graphicData>
      <drawSize>(3,3)</drawSize>
      <drawOffset>(0,0.01,0)</drawOffset>
      <texPath>Things/Building/MasonryProps/ArchSegmentedOne/UEM_Arch_Segmented_One</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <uiIconPath>Things/Building/MasonryProps/ArchSegmentedOne/UEM_Arch_Segmented_One_Icon</uiIconPath>
    <uiIconScale>2.0</uiIconScale>
    <size>(1,1)</size>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <researchPrerequisites>
      <li>Stonecutting</li>
    </researchPrerequisites>
    <blockWind>false</blockWind>
    <tickerType>Never</tickerType>
    <clearBuildingArea>false</clearBuildingArea>
  </ThingDef>

