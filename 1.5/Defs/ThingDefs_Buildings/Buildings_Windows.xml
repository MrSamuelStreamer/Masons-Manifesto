<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- SHORT WINDOW -->
  <ThingDef ParentName="BuildingBase">
    <defName>UEM_Window_Short</defName>
    <label>Short Window</label>
    <description>A decorative window meant to be placed over walls or ReBuild's window walls. This one is a short height.</description>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2101</uiOrder>
    <altitudeLayer>PawnUnused</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>10</Beauty>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <canOverlapZones>true</canOverlapZones>
    <fertility>0</fertility>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <paintable>true</paintable>
      <isEdifice>false</isEdifice>
      <isPlaceOverableWall>true</isPlaceOverableWall>
    </building>
    <graphicData>
      <texPath>Things/Building/MasonryProps/WindowShort/UEM_WindowShort</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <uiIconPath>Things/Building/MasonryProps/WindowShort/UEM_WindowShort_Icon</uiIconPath>
    <uiIconScale>1.0</uiIconScale>
    <size>(1,1)</size>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <researchPrerequisites>
      <li>Stonecutting</li>
    </researchPrerequisites>
    <blockWind>false</blockWind>
    <tickerType>Never</tickerType>
    <clearBuildingArea>false</clearBuildingArea>
  </ThingDef>

