<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- Door Base -->


  <ThingDef ParentName="DoorBase">
    <defName>UEM_Gate_Wood_One</defName>
    <label>Small Wooden Gate</label>
    <description>Divides rooms. Simple doors must be manually opened, which slows people down. The amount of slowdown depends on what the door is made of.</description>
    <designationCategory>Structure</designationCategory>
    <thingClass>Building_Door</thingClass>
    <graphicData>
      <texPath>Things/Building/MasonryProps/GateWoodOne/UEM_Gate_Wood_One</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <size>(1, 1)</size>
    <uiIconPath>Things/Building/MasonryProps/GateWoodOne/UEM_Gate_Wood_One_Icon</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <statBases>
      <WorkToBuild>1100</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
    </statBases>
    <costStuffCount>25</costStuffCount>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/MasonryProps/GateWoodOne/UEM_Gate_Wood_One_Icon</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <shaderType>EdgeDetect</shaderType>
      </blueprintGraphicData>
    </building>
  </ThingDef>

